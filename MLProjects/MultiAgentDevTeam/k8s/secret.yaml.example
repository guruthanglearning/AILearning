# Example only: scripts/deploy-k8s.ps1 creates this Secret for you from your local key
# (ANTHROPIC_API_KEY env var or appsettings.secrets.json), so you don't need this file.
#
# The name ends in .yaml.example, not .yaml, so `kubectl apply -f k8s/` ignores it and can't overwrite
# the real Secret with the placeholder. Never put a real key in this file.
#
# To create the Secret by hand without the script:
#   kubectl create secret generic agent-secrets -n multi-agent-dev-team \
#     --from-env-file=<file containing ANTHROPIC_API_KEY=...>
apiVersion: v1
kind: Secret
metadata:
  name: agent-secrets
  namespace: multi-agent-dev-team
type: Opaque
stringData:
  ANTHROPIC_API_KEY: "REPLACE_WITH_YOUR_ANTHROPIC_API_KEY"
