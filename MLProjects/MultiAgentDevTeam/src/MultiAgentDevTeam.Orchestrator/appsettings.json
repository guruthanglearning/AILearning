{
  "AgentConfiguration": {
    "AnthropicApiKey": "",
    "MaxReviewLoops": 3,
    "TimeoutSeconds": 1800,
    "MaxRetries": 4,
    "SessionStoragePath": "sessions",
    "RateLimitRequestsPerMinute": 10,
    "ProjectOutput": {
      "Enabled": true,
      "DefaultRoot": "C:\\Temp",
      "HostDrivesPath": ""
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
