{
  "title": "StockRecommendationPlatform — Overview",
  "uid": "stockrec-overview",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    { "type": "row", "title": "Service Health", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }, "id": 100, "collapsed": false, "panels": [] },
    {
      "id": 1, "type": "stat", "title": "Backend Up",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [ { "expr": "up{job=\"stockrec-backend\"}", "legendFormat": "up", "refId": "A" } ],
      "fieldConfig": { "defaults": { "mappings": [
        { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
      ], "thresholds": { "mode": "absolute", "steps": [ { "value": null, "color": "red" }, { "value": 1, "color": "green" } ] } }, "overrides": [] },
      "options": { "textMode": "value_and_name", "colorMode": "background" }
    },
    {
      "id": 2, "type": "timeseries", "title": "HTTP Request Rate by Status",
      "gridPos": { "h": 8, "w": 10, "x": 4, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [ { "expr": "sum(rate(http_requests_total{job=\"stockrec-backend\"}[1m])) by (status)", "legendFormat": "{{status}}", "refId": "A" } ],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 10, "stacking": { "mode": "normal" } } }, "overrides": [] }
    },
    {
      "id": 3, "type": "timeseries", "title": "HTTP p95 Latency by Endpoint",
      "gridPos": { "h": 8, "w": 10, "x": 14, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [ { "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{job=\"stockrec-backend\"}[5m])) by (le, handler))", "legendFormat": "{{handler}}", "refId": "A" } ],
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 5 } }, "overrides": [] }
    },
    {
      "id": 4, "type": "stat", "title": "5xx Error Rate (5m)",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [ { "expr": "100 * sum(rate(http_requests_total{job=\"stockrec-backend\", status=~\"5..\"}[5m])) / clamp_min(sum(rate(http_requests_total{job=\"stockrec-backend\"}[5m])), 1e-9)", "legendFormat": "error %", "refId": "A" } ],
      "fieldConfig": { "defaults": { "unit": "percent", "decimals": 2, "thresholds": { "mode": "absolute", "steps": [ { "value": null, "color": "green" }, { "value": 1, "color": "yellow" }, { "value": 5, "color": "red" } ] } }, "overrides": [] },
      "options": { "colorMode": "background" }
    },

    { "type": "row", "title": "Agent Performance", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 }, "id": 200, "collapsed": false, "panels": [] },
    {
      "id": 10, "type": "timeseries", "title": "Agent Latency p95 by Agent",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [ { "expr": "histogram_quantile(0.95, sum(rate(agent_latency_seconds_bucket[5m])) by (le, agent_name))", "legendFormat": "{{agent_name}}", "refId": "A" } ],
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 5 } }, "overrides": [] }
    },
    {
      "id": 11, "type": "timeseries", "title": "Agent Call Rate by Agent & Status",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [ { "expr": "sum(rate(agent_latency_seconds_count[1m])) by (agent_name, status)", "legendFormat": "{{agent_name}} — {{status}}", "refId": "A" } ],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "bars", "fillOpacity": 30, "stacking": { "mode": "normal" } } }, "overrides": [] }
    },

    { "type": "row", "title": "Batch Jobs", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 }, "id": 300, "collapsed": false, "panels": [] },
    {
      "id": 20, "type": "timeseries", "title": "Batch Symbols Processed by Outcome",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 19 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [ { "expr": "sum(rate(batch_job_symbols_total[5m])) by (outcome)", "legendFormat": "{{outcome}}", "refId": "A" } ],
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "drawStyle": "bars", "fillOpacity": 30, "stacking": { "mode": "normal" } } }, "overrides": [] }
    },
    {
      "id": 21, "type": "stat", "title": "Total Batch Symbols Processed",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 19 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [ { "expr": "sum(batch_job_symbols_total) by (outcome)", "legendFormat": "{{outcome}}", "refId": "A" } ],
      "options": { "colorMode": "value", "graphMode": "none", "textMode": "value_and_name" }
    },

    { "type": "row", "title": "Resource Usage", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 27 }, "id": 400, "collapsed": false, "panels": [] },
    {
      "id": 30, "type": "timeseries", "title": "Backend Process Memory (RSS)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [ { "expr": "process_resident_memory_bytes{job=\"stockrec-backend\"}", "legendFormat": "RSS", "refId": "A" } ],
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] }
    },
    {
      "id": 31, "type": "timeseries", "title": "Backend CPU Usage",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [ { "expr": "100 * rate(process_cpu_seconds_total{job=\"stockrec-backend\"}[1m])", "legendFormat": "CPU %", "refId": "A" } ],
      "fieldConfig": { "defaults": { "unit": "percent", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] }
    }
  ]
}
